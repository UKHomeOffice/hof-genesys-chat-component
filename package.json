{
  "name": "hof-genesys-chat-component",
  "version": "0.7.3",
  "author": "Home Office",
  "description": "Reusable Genesys chat component library with GDS styling for Home Office services",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "dist",
    "package.json",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "TZ=UTC jest --coverage",
    "postversion:ci": "git push && git push --tags"
  },
  "keywords": [
    "genesys",
    "chat",
    "messaging",
    "gds",
    "home-office"
  ],
  "license": "MIT",
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "babel-jest": "^30.5.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.64.7",
    "rollup-plugin-esbuild": "^6.2.1"
  },
  "resolutions": {
    "browserslist": "^4.29.3",
    "@humanfs/node": "^0.16.8",
    "brace-expansion": "^1.1.19",
    "js-yaml": "^3.15.0",
    "picomatch": "^2.3.2",
    "ws": "^8.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UKHomeOffice/hof-genesys-chat-component.git"
  },
  "bugs": {
    "url": "https://github.com/UKHomeOffice/hof-genesys-chat-component/issues"
  }
}
